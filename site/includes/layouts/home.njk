---
layout: base
---

<main id="main" class="main inner box-flex pt-800 pb-1100" tabindex="-1">

    <header class="page-header hero">

        {# Brand block shrinks to the title width so the mark can be sized as a
           fraction of that line (~1/3–1/2). The image is out of flow so its
           intrinsic size cannot inflate the box; empty alt because the h1
           carries the name. #}
        <div class="hero-brand">
            <img class="hero-logo" src="{{ '/images/meta/csf_icon.png' | url }}" alt="" width="789" height="795">
            {# The two nowrap spans let the headline break where it likes between
               them but never inside them, so "Science Futures" stays on one line at
               every width instead of stranding "Futures" on its own. #}
            <h1 class="hero-title"><span class="hero-line">Communication</span> <span class="hero-line">Science <span class="hero-accent">Futures</span></span></h1>
        </div>

        {% if hero_lede %}
            <p class="hero-lede">{{ hero_lede }}</p>
        {% endif %}

    </header>

    <div class="content flow">

        <div class="home-details" aria-label="Key conference details">
            {% if key_details %}
                <div class="home-info-cards">
                    {% for item in key_details %}
                        <div class="home-info-card">
                            <div class="card-body">
                                <span class="card-label">{{ item.label }}</span>
                                <span class="card-value">{{ item.value | safe }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
            {% if banner %}
                <div class="home-banner">
                    <div class="banner-text">{{ banner.text | safe }}</div>
                    {% if banner.primary or banner.secondary %}
                        <div class="banner-cta">
                            {% if banner.primary %}
                                <a class="button" href="{{ banner.primary.url }}"{% if banner.primary.external %} target="_blank" rel="noopener"{% endif %}>{{ banner.primary.label }}</a>
                            {% endif %}
                            {% if banner.secondary %}
                                <a class="button button--outline" href="{{ banner.secondary.url }}"{% if banner.secondary.external %} target="_blank" rel="noopener"{% endif %}>{{ banner.secondary.label }}</a>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {{ content | safe }}
    </div>

</main>
