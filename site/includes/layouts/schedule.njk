---
layout: base
data: agenda
---

<head>
    <!-- Place your kit's code here -->
    <script src="https://kit.fontawesome.com/4451d51824.js" crossorigin="anonymous"></script>
</head>

{# Renders the clickable grid of stage talks for a given theme (research / theory / methods). #}
{% macro talkgrid(theme) %}
    {% set talks = agenda | find("theme", theme) %}
    {% if talks | length %}
        <h2 class="agenda-grid-title">Presentations:</h2>
        <div class="box-grid agenda-grid">
            {% for item in talks %}
                <div class="agenda-card" onclick="location.href='{{ ('/agenda-items/item-' + (item.number | string) + '/') | url }}'">
                    <div class="card-body">
                        <div class="item-title text-500">{{ item.title }}</div>
                        <div class="item-presenter text-500">
                            <div><i class="fas fa-solid fa-user" style="padding:0 .5em 0 0; color:grey"></i> <b>{{ item.presenter }}</b></div>
                            <div><i class="fas fa-university" style="padding:0 .5em 0 0; color: grey"></i> {{ item.affiliation }}</div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{# Renders the poster listing for a given session (1 = Saturday lunch, 2 = Sunday lunch).
   Posters get a lighter multi-column treatment than stage talks: no cards, no detail
   pages, since there are ~15 per session and no abstracts to link to. #}
{% macro postergrid(session) %}
    {% set sheet = posters | find("session", session) %}
    {% if sheet | length %}
        <h2 class="agenda-grid-title poster-grid-title">Posters ({{ sheet | length }}):</h2>
        {# --poster-rows drives the column fill: items flow down column 1 for this many
           rows, then down column 2, preserving alphabetical order within each column
           while grid equalises each row's height. #}
        <div class="poster-list" style="--poster-rows: {{ (sheet | length / 2) | round(0, 'ceil') }}">
            {% for p in sheet %}
                <div class="poster-item">
                    <div class="poster-title">{{ p.title }}</div>
                    <div class="poster-presenter">
                        <div><i class="fas fa-solid fa-user" style="padding:0 .5em 0 0; color:grey"></i> <b>{{ p.presenter }}</b></div>
                        <div><i class="fas fa-university" style="padding:0 .5em 0 0; color:grey"></i> {{ p.affiliation }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

<main id="main" class="main inner box-flex pt-600 pb-1100" tabindex="-1">

    <article id="container-centre" class="column centre">

        <header class="page-header">

            <h1 class="page-title">{{ title }}</h1>

            {% if sub_heading %}

                <p class="sub-heading">{{ sub_heading }}</p>

            {% endif %}

        </header>

        <div class="content flow"></div>

        <div class="inner">

            <div class = "callout" style = "margin-top: 2rem">
                <div class = "callout-icon">
                    <i class="fas fa-exclamation-circle color-grey"></i>
                </div>
                <div class = "callout-text">
                    {{ content | safe }}
                </div>
            </div>
        </div>

        <div class = "event-body-text">
            <h2>Conference Location</h2>
            MSU Union, 49 Abbot Rd, East Lansing, MI 48824

            {# Address-query embed rather than a !pb coordinate string: the previous one was
               centred on 42.7240889,-84.48504, about a km south of the Union near Wilson/Stadium.
               Letting Google geocode the address keeps it right and is far less fragile. #}
            <iframe src="https://www.google.com/maps?q=MSU%20Union%2C%2049%20Abbot%20Rd%2C%20East%20Lansing%2C%20MI%2048824&amp;z=16&amp;output=embed" width="100%" height="400" style="border:0; padding: 1rem 0rem" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map showing the MSU Union, 49 Abbot Rd, East Lansing, MI"></iframe>
        </div>

        {# ===== FRIDAY ===== #}

        <div class = "day-header">
            <h1> Friday, September 18 </h1>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 4:00pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Doors Open & Check-In </div>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 5:00 - 6:00pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Keynote Address </div>
            <div class = "keynote-callout">
                <img class = "keynote-headshot" src="{{ '/images/headshots/pennebaker.jpg' | url }}" alt="James W. Pennebaker">
                <div>
                    <div class = "keynote-text">
                        <strong>Keynote Speaker:</strong> James W. Pennebaker
                    </div>
                    <div class = "keynote-abstract">
                        Talk title TBD.
                    </div>
                </div>
            </div>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 6:00 - 9:00pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Opening Reception & Dinner </div>
            <div class = "event-body-text">
                Join us for dinner and drinks following the keynote address.
            </div>
        </div>

        {# ===== SATURDAY ===== #}

        <div class = "day-header">
            <h1> Saturday, September 19 </h1>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 8:30 - 9:00am </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Welcome & Introduction </div>
            <div class = "event-body-text">
                Breakfast, coffee, and tea will be provided.
            </div>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 9:00 - 10:30am </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Panel 1 — Futures in Research </div>
            <div class = "event-body-text">
                Stage presentations selected from the submission pool, exploring forces, trends, and topics shaping the future of communication research.
            </div>
        </div>

        {{ talkgrid("research") }}

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 10:30am - 12:00pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Breakout Session 1 </div>
            <div class = "event-body-text">
                Small-format discussions and workshops on "hot topics" submitted by attendees. Some will build on panel and poster content; others will be standalone.
            </div>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 12:00 - 1:30pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Lunch & Poster Session 1 </div>
        </div>

        {{ postergrid(1) }}

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 1:30 - 3:00pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Panel 2 — Futures in Theory </div>
            <div class = "event-body-text">
                Stage presentations addressing issues and advancements in communication theory building, testing, and formalization.
            </div>
        </div>

        {{ talkgrid("theory") }}

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 3:00 - 4:30pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Breakout Session 2 </div>
            <div class = "event-body-text">
                Small-format discussions and workshops on "hot topics" submitted by attendees. Some will build on panel and poster content; others will be standalone.
            </div>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 4:30 - 5:00pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Closing Remarks </div>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> Evening </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Happy Hour </div>
            <div class = "event-body-text"> Location TBA </div>
        </div>

        {# ===== SUNDAY ===== #}

        <div class = "day-header">
            <h1> Sunday, September 20 </h1>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 8:30 - 9:00am </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Welcome & Introduction </div>
            <div class = "event-body-text">
                Breakfast, coffee, and tea will be provided.
            </div>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 9:00 - 10:30am </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Panel 3 — Futures in Methods </div>
            <div class = "event-body-text">
                Stage presentations highlighting new methods for collecting, analyzing, and reporting communication data.
            </div>
        </div>

        {{ talkgrid("methods") }}

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 10:30am - 12:00pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Breakout Session 3 </div>
            <div class = "event-body-text">
                Tool demos, workshops, and discussion groups. Participants choose between technical demos and interactive sessions. Content depends on submissions.
            </div>
        </div>

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 12:00 - 1:30pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Lunch & Poster Session 2 </div>
        </div>

        {{ postergrid(2) }}

        <div class = "event-title">
            <div class = "time-divider">
                <div class="time-chip"> 1:30 - 5:00pm </div>
                <div class = "time-hr"><hr></div>
            </div>
            <div class = "event-title-text"> Follow-Up Discussions & Unstructured Time </div>
            <div class = "event-body-text">
                Time reserved for attendees to continue discussions, meet with collaborators, or explore campus and the surrounding area.
            </div>
        </div>

    </article>

</main>
