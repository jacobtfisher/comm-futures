---
layout: base
data: agenda
---

<head>
    <!-- Place your kit's code here -->
    <script src="https://kit.fontawesome.com/4451d51824.js" crossorigin="anonymous"></script>
</head>

{# Renders the grid of stage talks for a given theme (research / theory / methods).

   Each card is an expander: the trigger is a real <button> (it used to be a div
   with an onclick, so it could not be reached or fired from the keyboard) and
   the abstract lives in a sibling panel that JS reveals in place, widening the
   card across the whole grid row. resources/js/modules/talk-cards handles the
   toggling; without JS the panel is simply always open, so every abstract is
   still readable. #}
{% macro talkgrid(theme) %}
    {% set talks = agenda | find("theme", theme) %}
    {% if talks | length %}
        <h2 class="agenda-grid-title">Presentations:</h2>
        <div class="agenda-grid">
            {% for item in talks %}
                <div class="agenda-card" id="talk-{{ item.number }}">
                    <button type="button" class="agenda-card-trigger"
                            aria-expanded="false" aria-controls="talk-panel-{{ item.number }}">
                        <span class="item-title">{{ item.title }}</span>
                        <span class="item-presenter">
                            <span class="meta-row"><i class="fas fa-solid fa-user meta-icon" aria-hidden="true"></i><span class="meta-text">{{ item.presenter }}</span></span>
                            <span class="meta-row"><i class="fas fa-university meta-icon" aria-hidden="true"></i><span class="meta-text">{{ item.affiliation }}</span></span>
                        </span>
                    </button>
                    <div class="agenda-card-panel" id="talk-panel-{{ item.number }}">
                        {% if item.headshot %}
                            <img class="panel-headshot" src="{{ item.headshot | url }}" alt="{{ item.presenter }}" loading="lazy">
                        {% endif %}
                        <div class="panel-body">
                            <span class="theme-chip">Futures in {{ item.theme | capitalize }}</span>
                            <p class="panel-abstract">{{ item.abstract }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{# Renders the poster listing for a given session (1 = Saturday lunch, 2 = Sunday lunch).
   Posters get a lighter multi-column treatment than stage talks: no cards, no detail
   pages, since there are ~15 per session and no abstracts to link to. #}
{% macro postergrid(session) %}
    {% set sheet = posters | find("session", session) %}
    {% if sheet | length %}
        <h2 class="agenda-grid-title poster-grid-title">Posters ({{ sheet | length }}):</h2>
        {# --poster-rows drives the column fill: items flow down column 1 for this many
           rows, then down column 2, preserving alphabetical order within each column
           while grid equalises each row's height. #}
        <div class="poster-list" style="--poster-rows: {{ (sheet | length / 2) | round(0, 'ceil') }}">
            {% for p in sheet %}
                <div class="poster-item">
                    <div class="poster-title">{{ p.title }}</div>
                    <div class="poster-presenter">
                        <span class="meta-row"><i class="fas fa-solid fa-user meta-icon" aria-hidden="true"></i><span class="meta-text">{{ p.presenter }}</span></span>
                        <span class="meta-row"><i class="fas fa-university meta-icon" aria-hidden="true"></i><span class="meta-text">{{ p.affiliation }}</span></span>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

<main id="main" class="main inner box-flex pt-600 pb-1100" tabindex="-1">

    <article id="container-centre" class="column centre">

        <header class="page-header">

            <h1 class="page-title">{{ title }}</h1>

            {% if sub_heading %}

                <p class="sub-heading">{{ sub_heading }}</p>

            {% endif %}

        </header>

        <div class="content flow"></div>

        <div class="inner">

            <div class = "callout" style = "margin-top: 2rem">
