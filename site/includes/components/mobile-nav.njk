<nav id="mobile-nav" class="mobile-nav z-20" aria-label="Mobile">

    {% set navigation = collections.all | eleventyNavigation %}

    <ul class="mobile-nav-list">

        {%- for item in navigation %}

            <li class="item">
                <a href="{{ item.url | url }}" class="link {{ 'active' if item.url === page.url }}" {{ 'aria-current=page' if item.url === page.url }}>{{ item.title }}</a>
            </li>

        {%- endfor %}

        <li class="item item-cta">
            <a href="{{ '/schedule/' | url }}" class="link link-get-started {{ 'active' if page.url === '/schedule/' }}" {{ 'aria-current=page' if page.url === '/schedule/' }}>Schedule</a>
        </li>

    </ul>

</nav>

<button id="mobile-nav-toggle" class="mobile-nav-toggle z-20" aria-label="Mobile Navigation Toggle" aria-expanded="false" aria-controls="mobile-nav">

    <span class="mobile-nav-label">Menu</span>

    <span class="mobile-nav-icon" aria-hidden="true">
        <span class="icon-line"></span>
        <span class="icon-line"></span>
        <span class="icon-line"></span>
    </span>

</button>
