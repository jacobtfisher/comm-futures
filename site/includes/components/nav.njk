<nav id="nav" class="nav box-hidden mobileXL:box-block" aria-label="Primary">

    {% set navigation = collections.all | eleventyNavigation %}

    <ul class="menu mobileXL:box-flex">

        {%- for item in navigation %}

            <li class="item">

                <a href="{{ item.url | url }}" class="link box-block color-ink weight-semibold pl-300 pr-300 {{ 'active' if item.url === page.url }}" {{ 'aria-current=page' if item.url === page.url }}>{{ item.title }}</a>

            </li>

        {%- endfor %}

        <li class="item ml-400"><a href="{{ '/schedule/' | url }}" class="link link-get-started box-block weight-semibold pl-500 pr-500 {{ 'active' if page.url === '/schedule/' }}" {{ 'aria-current=page' if page.url === '/schedule/' }}>Schedule</a></li>

    </ul>

</nav>
